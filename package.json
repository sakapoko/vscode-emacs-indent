{
	"name": "vscode-emacs-indent",
	"displayName": "vscode-emacs-indent",
	"description": "emacs like indent",
	"version": "0.0.3",
	"publisher": "sakapoko",
	"repository": {
		"type": "git",
		"url": "https://github.com/sakapoko/vscode-emacs-indent.git"
	},
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Other"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "emacs-indent.reindentCurrentLine",
				"title": "reindent current line"
			}
		],
		"keybindings": [
			{
				"key": "tab",
				"command": "emacs-indent.reindentCurrentLine",
				"when": "editorTextFocus && !editorReadonly && !inSnippetMode && !(inlineSuggestionVisible || suggestWidgetVisible)"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"lint": "eslint src --ext .ts",
		"lint:fix": "eslint src --ext .ts --fix",
		"test": "npm run compile && node ./out/test/runTest.js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/mocha": "^10.0.10",
		"@types/node": "^25.5.0",
		"@types/vscode": "^1.85.0",
		"@typescript-eslint/eslint-plugin": "^8.57.1",
		"@typescript-eslint/parser": "^8.57.1",
		"@vscode/test-electron": "^2.5.2",
		"eslint": "^10.0.3",
		"glob": "^13.0.6",
		"globals": "^17.4.0",
		"mocha": "^11.7.5",
		"typescript": "^5.9.3"
	}
}
